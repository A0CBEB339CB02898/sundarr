SUNDARR_APP_NAME=Sundarr
SUNDARR_APP_VERSION=0.1.0
SUNDARR_DATABASE_URL=postgresql+psycopg://sundarr:change_me@postgres:5432/sundarr
# Redis 无密码：redis://redis:6379/0
# Redis 有密码：redis://:change_me@redis:6379/0
SUNDARR_REDIS_URL=redis://:change_me@redis:6379/0
SUNDARR_CLOUD_STAGING_ROOT=/Sundarr/_staging

# 真实 SMB 仅用于手动开发测试，不应提交到 .env 之外。
# 当前应用运行时 SMB 配置仍以 POST /storage/config/save 写入 settings 表为准。
SUNDARR_DEV_SMB_HOST=nas.example.invalid
SUNDARR_DEV_SMB_PORT=445
SUNDARR_DEV_SMB_SHARE=share
SUNDARR_DEV_SMB_USERNAME=your_user
SUNDARR_DEV_SMB_PASSWORD=your_password
SUNDARR_DEV_SMB_DOMAIN=
SUNDARR_DEV_SMB_BASE_PATH=/
